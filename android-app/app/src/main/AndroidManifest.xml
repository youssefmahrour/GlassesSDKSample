<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════
         Bluetooth Permissions
         NOTE: neverForLocation is only valid on BLUETOOTH_SCAN/CONNECT/ADVERTISE
               and NEARBY_WIFI_DEVICES. Do NOT use it on legacy BLUETOOTH/BLUETOOTH_ADMIN.
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Legacy Bluetooth (API < 31) — no usesPermissionFlags -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- ════════════════════════════════════════════════════════════
         Network / WiFi Permissions
         NOTE: CHANGE_NETWORK_STATE, ACCESS_NETWORK_STATE, CHANGE_WIFI_STATE,
               ACCESS_WIFI_STATE do NOT support usesPermissionFlags.
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for WiFi P2P multicast / peer discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ════════════════════════════════════════════════════════════
         Storage Permissions
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ════════════════════════════════════════════════════════════
         Location Permissions
         NOTE: ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION do NOT support
               neverForLocation — they ARE location permissions.
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <!-- ════════════════════════════════════════════════════════════
         Wi-Fi Direct / Nearby Devices (API 33+)
         neverForLocation is valid here — tells the system this app won't
         derive location from nearby WiFi devices.
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- ════════════════════════════════════════════════════════════
         Other Permissions
         ════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".ui.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassesSDKSample"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- XXPermissions: Tell the framework that the project has adapted to partitioned storage -->
        <meta-data
            android:name="ScopedStorage"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.DeviceBindActivity" android:exported="true" />
        <activity android:name=".ai.VisionActivity" />
    </application>

</manifest>